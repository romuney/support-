    {
      "parameters": {
        "jsCode": "\nconst CONF = { high: 'высокая', medium: 'средняя', none: 'нет ответа' };\nconst a = $json;\nconst lines = [a.draft || '(пусто)'];\n// В чате видно всё, включая ТЗ: адресат здесь — тот, кто правит промпт,\n// и ему нужно проверить оба блока, а не только тот, что уйдёт заказчику.\nif (a.tech_spec) {\n  lines.push('');\n  lines.push('ТЗ ДЛЯ АНАЛИТИКА: ' + a.tech_spec);\n}\nlines.push('');\nlines.push('ИСТОЧНИКИ: ' + (a.sources || '—'));\n// В чате печатаем и заявленное, и действующее: адресат здесь — тот, кто правит\n// промпт, и ему нужно видеть именно расхождение.\nlines.push('УВЕРЕННОСТЬ: ' + (CONF[a.confidence_key] || a.confidence || '—') +\n  (a.confidence_capped\n    ? ' (бот заявил ' + (CONF[a.confidence_claimed] || a.confidence_claimed) +\n      '; понижено: ' + a.confidence_capped_reason + ')'\n    : ''));\nif (Array.isArray(a.confidence_basis) && a.confidence_basis.length) {\n  lines.push('ОСНОВАНИЕ: ' + a.confidence_basis.join(' · '));\n}\nif (a.gaps) lines.push('ЧЕГО НЕ ХВАТИЛО: ' + a.gaps);\nif (Array.isArray(a.kb_tasks) && a.kb_tasks.length) {\n  lines.push('ЗАДАЧА ДЛЯ БАЗЫ:');\n  for (const t of a.kb_tasks) lines.push('  — ' + t);\n}\nif (a.parse_error) lines.push('РАЗБОР: ' + a.parse_error);\nreturn [{ json: { output: lines.join('\\n') } }];\n"
      },
      "type": "n8n-nodes-base.code",
