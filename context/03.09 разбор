-- Список сотрудников с атрибутами, детьми, образованием и итоговыми годовыми оценками
-- Джойны с детьми, образованием и оценками выполнены с предварительной агрегацией/фильтрацией, чтобы не размножать строки сотрудников.
-- Гранулярность результата: одна строка = один сотрудник (актуальные, неуволенные).
SELECT
    e.mdm_employee_rk,  -- Мастер ID
    e.last_nm,  -- Фамилия, 🔒 нужен доступ: EMP_INDIR
    e.first_nm,  -- Имя, 🔒 нужен доступ: EMP_INDIR
    e.grade,  -- Грейд, 🔒 нужен доступ: HR_GRADE
    e.emp_stream_desc,  -- Стрим
    e.emp_specialization_desc,  -- Специализация
    current_date - e.company_hire_dt AS experience_days,  -- Стаж в компании в днях
    COALESCE(c.children_cnt, 0) AS children_cnt,  -- Количество детей
    ed.education_info,  -- Информация об образовании (уровень, ВУЗ, специальность)
    se.summary_score  -- Итоговая годовая оценка (из summary_evaluation), 🔒 нужен доступ: HR_REVIEW
FROM prod_v_emart.mdm_employee_structure_d e
LEFT JOIN (
