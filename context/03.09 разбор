    FROM prod_v_hrmart.mdm_employee_education
    WHERE deleted_flg = 0
    GROUP BY mdm_employee_rk
) ed ON ed.mdm_employee_rk = e.mdm_employee_rk
LEFT JOIN (
    -- Отбираем ТОЛЬКО актуальные версии итоговых оценок
    SELECT
        mdm_employee_rk,
        summary_score,
        business_dt
    FROM prod_v_hrmart.summary_evaluation
    WHERE valid_to_dttm = '5999-01-01'  -- актуальная версия
      AND deleted_flg = 0
) se ON se.mdm_employee_rk = e.mdm_employee_rk
WHERE e.last_day_flg = 1  -- актуальный срез на текущую дату
  AND e.active_employee_flg = 1  -- только активные сотрудники
  AND e.company_fire_flg = 0  -- не уволенные
ORDER BY e.last_nm, e.first_nm;
