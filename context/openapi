  /api/v3/full-entity:
    post:
      operationId: postFullEntity
      tags: [ entity ]
      summary: Create full entity with all resources and relations
      description: Create entity
      requestBody:
        description: Entity payload
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FullEntityWithRelations'
      responses:
        200:
          description: Entity created
          content:
            application/json:
              schema:
                title: EntityUrn
                type: string
                description: Entity urn for created entity
                example: urn:dd:system:entity_type:entity_name
        401:
