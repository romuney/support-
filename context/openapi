paths:
  /api/v3/search/query:
    post:
      tags:
        - search
      operationId: searchQuery
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SearchRequest'
      responses:
        200:
          description: Список найденных карточек
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/SearchCard'
        401:
          description: Unauthorized
        400:
          $ref: '#/components/responses/ValidationError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/search/facets/{facetKey}/filters:
    post:
      tags:
        - search
      summary: getFacetFilters
      operationId: getFacetFilters
      parameters:
        - name: facetKey
          in: path
          required: true
          description: Системный ключ фасета
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SearchFacetFiltersRequest'
      responses:
        200:
          description: Список фильтров фасета
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/SearchFacetFilter'
        401:
          description: Unauthorized
        400:
          $ref: '#/components/responses/ValidationError'
        404:
          description: Фасет с переданным названием не существует
        default:
          $ref: '#/components/responses/DefaultError'
  /api/v3/batch:
    post:
      summary: Выполнить батч-операции в транзакции
      operationId: executeBatch
      tags: [ batch ]
      description: Примеры всех типов операцией есть [здесь](https://gitlab.tcsbank.ru/mg/dd-catalog/-/blob/master/component-test/src/componentTest/resources/BatchTest/catalog-request.json)
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              additionalProperties:
                $ref: '#/components/schemas/BatchOperation'
      responses:
        200:
          description: Ok
          content:
            application/json:
              schema:
                type: object
                additionalProperties:
                  $ref: '#/components/schemas/BatchOperationResult'
        401:
          $ref: '#/components/responses/NotAuthorizedError'
        403:
          $ref: '#/components/responses/ForbiddenError'
        404:
          $ref: '#/components/responses/NotFoundError'
        400:
