          description: Валидация пройдена успешно, ошибок нет
        '200':
          description: Результат валидации изменений
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ValidationResult'
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/approvals:
    get:
      tags:
        - change-request
      summary: Get Approvals by CR
      description: Возвращает список согласований для запроса на изменение.
      operationId: getChangeApproveStateByChangeRequestId
      parameters:
        - $ref: '#/components/parameters/crId'
      responses:
        '200':
          description: Аппруверы успешно посчитаны и возвращены
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApprovalsResponse'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/publish:
    post:
      tags:
        - change-request
      summary: Publish Change Request
      description: |
        Применяет все изменения из запроса, если:
        - Статус = `open`
        - Состояние = `approved`
        - Нет ошибок валидации
        - Нет конфликтов

        Валидация и проверка аппрувов пересчитывается перед проверкой.
      operationId: publishChangeRequest
      parameters:
        - $ref: '#/components/parameters/crId'
      requestBody:
        required: false
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Comment'
      responses:
        '204':
          description: Запрос успешно опубликован
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/close:
    post:
      tags:
        - change-request
      summary: Close Change Request
      description: |
        Переводит запрос на изменение из статуса open в closed.
        После перевода статус устанавливается в `closed`, а флаг `wip` в `false`, апрувы слетают.
        Опционально может быть передан комментарий.
      operationId: closeChangeRequest
      parameters:
        - $ref: '#/components/parameters/crId'
      requestBody:
        required: false
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Comment'
      responses:
        '200':
          description: Запрос успешно переведён в статус closed
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChangeRequestStatusUpdateResponse'
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/approve:
    post:
      tags:
        - change-request
      summary: Approve Change Request
      description: |
        Фиксирует факт подтверждения (approve) запроса на изменение от имени пользователя.
        Доступно только если статус CR = open
      operationId: approveChangeRequest
      parameters:
        - $ref: "#/components/parameters/crId"
      requestBody:
        description: Данные для подтверждения запроса
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ApproveRequest'
      responses:
        '204':
          description: Запрос успешно подтверждён
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/unapprove:
    post:
      tags:
        - change-request
      summary: Unapprove Change Request
      description: |
        Убирает статус Approved у CR от вызвавшего пользователя
      operationId: unapproveChangeRequest
      parameters:
        - $ref: '#/components/parameters/crId'
      requestBody:
        description: Данные для снятия подтверждения
        required: false
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Comment'
      responses:
        '204':
          description: Подтверждение успешно снято
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/changes:
    get:
      tags:
        - change-request
      summary: Получить changes в Change Request
      description: Возвращает постранично список изменений в указанном CR
      operationId: getChangeRequestChanges
      parameters:
        - $ref: '#/components/parameters/crId'
        - name: page
          in: query
          description: Номер страницы (начинается с 0)
          required: false
          schema:
            type: integer
            default: 0
            minimum: 0
        - name: size
          in: query
          description: Размер страницы
          required: false
          schema:
            type: integer
            default: 10
            minimum: 1
            maximum: 50
        - name: includeEmpty
          in: query
          description: Включать ли empty изменения в ответ. По умолчанию false.
          required: false
          schema:
            type: boolean
            default: false
      responses:
        '200':
          description: Список changes успешно возвращён
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChangeRequestChangeListResponse'
        '400':
          $ref: '#/components/responses/ValidationError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'
    patch:
      tags:
        - change-request
      summary: Update Changes in CR
      description: |
        Обновляет пакет изменений, связанных с запросом.
        Доступно только если:
        - Статус CR — `open`

        При успешном обновлении:
        - Все существующие `approve` снимаются
        - Состояние `approved` для всего CR пересчитывается
      operationId: updateChangeRequestChanges
      parameters:
        - $ref: '#/components/parameters/crId'
      requestBody:
        description: Массив изменений
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateChangeRequestChange'
      responses:
        '200':
          description: Изменения успешно обновлены
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UpdateChangesResponse'
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/change-request/{id}/rebase:
    post:
      tags:
        - change-request
      summary: Rebase Change Request
      description: |
        Возвращает актуальное значение данных в change'ах, где требуется ребейз.
        Используется, если другие изменения уже внесены в те же ресурсы.
        Доступно только в статусе open.
      operationId: rebaseChangeRequest
      parameters:
        - $ref: '#/components/parameters/crId'
      responses:
        '200':
          description: Успешно. Возвращены изменения с актуальными данными.
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/RebaseConflictItem'
        '400':
          $ref: '#/components/responses/ValidationsError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '403':
          $ref: '#/components/responses/ForbiddenError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/lineage/{urn}:
    get:
      tags:
        - lineage
      summary: Get lineage
      description: |
        Возвращает lineage для сущности в формате JSON.
      operationId: getLineage
      parameters:
        - $ref: '#/components/parameters/urn'
        - name: direction
          in: query
          description: Направление (FORWARD/BACKWARD)
          required: true
          schema:
            $ref: '#/components/schemas/LineageDirection'
        - name: depth
          in: query
          description: Глубина обхода графа
          required: false
          schema:
            type: integer
            default: 2
            minimum: 1
            maximum: 5
        - name: relationTypes
          in: query
          description: Типы связей для фильтрации
          required: false
          schema:
            type: array
            items:
              type: string
            uniqueItems: true
            default: ["LOADS", "SUPPLIES", "READS", "WRITES"]
        - name: entityTypes
          in: query
          description: Фильтр по типам сущностей
          required: false
          schema:
            type: array
            items:
              type: string
            uniqueItems: true
        - name: schemas
          in: query
          description: Фильтр по схемам (для PHYSICAL_TABLE и PHYSICAL_COLUMN)
          required: false
          schema:
            type: array
            items:
              type: string
            uniqueItems: true
      responses:
        '200':
          description: Текстовое lineage в формате JSON
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LineageNode'
        '400':
          $ref: '#/components/responses/ValidationError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'

  /api/v3/tree/{urn}/parents:
    get:
      tags:
        - tree
      summary: Get parent entities
      description: |
        Возвращает список родителей для указанной сущности.
        Массив отсортирован от ближнего к дальнему родительскому узлу.
      operationId: getParents
      parameters:
        - $ref: '#/components/parameters/urn'
        - name: depth
          in: query
          description: Глубина обхода графа
          required: false
          schema:
            type: integer
            default: 2
            minimum: 1
            maximum: 10
      responses:
        '200':
          $ref: '#/components/responses/ParentsResponse'
        '400':
          $ref: '#/components/responses/ValidationError'
        '401':
          $ref: '#/components/responses/NotAuthorizedError'
        '404':
          $ref: '#/components/responses/NotFoundError'
        default:
          $ref: '#/components/responses/DefaultError'



