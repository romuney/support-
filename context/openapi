        - name: objectUrns
          in: query
          description: Поиск по urn объектов в CR
          required: false
          schema:
            type: array
            uniqueItems: true
            items:
              type: string
        - name: statuses
          in: query
          description: Фильтр по статусу запроса. Допустимые значения - open, closed, published
          required: false
          schema:
            type: array
            items:
              $ref: '#/components/schemas/ChangeRequestStatus'
            uniqueItems: true
        - name: openStates
          in: query
          description: |
            Детализированные состояния для OPEN
            in_progress - wip=true
            review - wip=false, approved=false
            approved - wip=false, approved=true
          required: false
          schema:
            type: array
            items:
              $ref: '#/components/schemas/CombinedOpenState'
            uniqueItems: true
        - name: createdBy
          in: query
          description: Логины пользователей или названия SA
          required: false
          schema:
            type: array
            uniqueItems: true
            items:
              type: string
        - name: approvers
          in: query
          description: Логины пользователей или названия SA
          required: false
          schema:
            type: array
            uniqueItems: true
            items:
              type: string
        - name: page
          in: query
          description: Номер страницы (начинается с 0)
          required: true
          schema:
            type: integer
            default: 0
            minimum: 0
        - name: size
          in: query
          description: Размер страницы (количество элементов)
          required: true
          schema:
            type: integer
            default: 20
            minimum: 1
            maximum: 100
